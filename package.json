{
  "name": "siyuan-table-merge",
  "version": "0.2.1",
  "description": "Safely merge and deduplicate reviewed, same-schema resource tables in SiYuan.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Acetab/siyuan-table-merge.git"
  },
  "scripts": {
    "assets": "node scripts/render-assets.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build:code": "vite build",
    "build": "npm run assets && npm run build:code",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "validate:marketplace": "node scripts/validate-marketplace.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "sharp": "^0.35.3",
    "siyuan": "^1.2.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5"
  }
}
